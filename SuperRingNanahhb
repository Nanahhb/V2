local status = label("STATUS: Ready", 212, 22, 12)
status.TextWrapped = true

local details = label("Parts found: 0", 236, 22, 12)

local function stopCheck()
    if connection then
        connection:Disconnect()
        connection = nil
    end
end

local function refreshDiagnostics()
    local character = player.Character
    local root = character and
        character:FindFirstChild("HumanoidRootPart")

    local count = 0
    local nearby = 0

    -- Chi thong ke, khong thay doi vat the
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            count += 1

            if root and (obj.Position - root.Position).Magnitude <= radius then
                nearby += 1
            end
        end
    end

    details.Text = "Parts: " .. count ..
        " | Nearby: " .. nearby

    if not root then
        status.Text = "STATUS: Character not ready"
    elseif count == 0 then
        status.Text = "STATUS: No Parts found"
    elseif nearby == 0 then
        status.Text = "STATUS: No Parts in radius"
    else
        status.Text = "STATUS: Parts detected"
    end
end

radiusBox.FocusLost:Connect(function()
    radius = math.clamp(tonumber(radiusBox.Text) or 10, 2, 100)
    radiusBox.Text = tostring(radius)
    if enabled then refreshDiagnostics() end
end)

speedBox.FocusLost:Connect(function()
    spinSpeed = math.clamp(tonumber(speedBox.Text) or 2, 0.1, 10)
    speedBox.Text = tostring(spinSpeed)
end)

toggle.Activated:Connect(function()
    enabled = not enabled

    if enabled then
        toggle.Text = "RING: ON"
        status.Text = "STATUS: Checking..."
        stopCheck()

        connection = RunService.Heartbeat:Connect(function()
            -- Cap nhat thong ke theo chu ky, tranh quet moi frame
            if not gui.Parent then
                stopCheck()
                return
            end
        end)

        task.spawn(function()
            while enabled and gui.Parent do
                refreshDiagnostics()
                task.wait(2)
            end
        end)
    else
        toggle.Text = "RING: OFF"
        status.Text = "STATUS: Paused"
        stopCheck()
    end
end)

gui.Destroying:Connect(function()
    enabled = false
    stopCheck()
end)

